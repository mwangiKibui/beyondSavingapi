APP_ENV=development
APP_PORT=8000

POSTGRES_USER=beyondsaving
POSTGRES_PASSWORD=beyondsaving
POSTGRES_DB=beyondsaving
POSTGRES_PORT=5432

REDIS_PORT=6379

# Object storage. Locally: the RustFS `storage` service (console at
# http://localhost:9001/rustfs/console/). Test/prod: DigitalOcean Spaces -
# set STORAGE_ENDPOINT/STORAGE_REGION on the app and worker instead.
STORAGE_ACCESS_KEY=storageadmin
STORAGE_SECRET_KEY=storageadmin
STORAGE_API_PORT=9000
STORAGE_CONSOLE_PORT=9001

# Dev-only placeholder — replace with a real secret for any non-local deployment.
JWT_SECRET=dev-secret-change-me

# Dev-only placeholder. Keys the hash of private category-suggestion keys
# (ab-253). Set a real one per environment and NEVER change it afterwards:
# stored hashes would stop matching and remembered categories would be lost.
SUGGESTION_KEY_SECRET=dev-suggestion-secret-change-me

# Comma-separated list of origins allowed to call this API from a browser.
CORS_ORIGINS=http://localhost:3000
